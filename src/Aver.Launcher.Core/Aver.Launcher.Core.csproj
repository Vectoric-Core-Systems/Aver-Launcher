<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The launcher's model layer: versions, manifests, feed documents, install inventory, planning.

    Deliberately net10.0 and NOT net10.0-windows, and it references no Windows API and no HttpClient.
    Everything in here is a pure function of its inputs, which is what makes the update planner and
    the manifest parsers testable without a GPU, a network or a registry. Anything needing P/Invoke
    belongs in Aver.Launcher.Platform; anything needing sockets belongs in Aver.Launcher.Updater.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
