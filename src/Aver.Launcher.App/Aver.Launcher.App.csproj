<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>AverLauncher</AssemblyName>
    <RootNamespace>Aver.Launcher.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RollForward>LatestMinor</RollForward>
    <!-- xaml codegen emits members this analyzer set dislikes; the C# is still warning clean. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Our own Main, because the process has two modes: the probe form must answer on stdout and exit
      without ever constructing an Application. The SDK's generated entry point would both conflict
      with it and start WPF before the argument could be read.
    -->
    <StartupObject>Aver.Launcher.App.App</StartupObject>
    <!--
      WPF cannot run in globalization-invariant mode. Its font cache builds a CultureInfo("en") while
      measuring the first run of text, and invariant mode throws CultureNotFoundException from a static
      constructor, so the process dies on the first TextBlock rather than anywhere informative.
      The repo-wide default stays on for the non-UI projects; nothing here depends on it, because every
      comparison in the launcher passes an explicit StringComparison.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aver.Launcher.Core\Aver.Launcher.Core.csproj" />
    <!--
      Platform is referenced so the probe form of this executable can create a D3D12 device. The UI
      itself never calls it in process: it re-execs THIS binary and reads JSON back, because a launcher
      that faults inside a graphics driver while probing is a launcher that cannot report the fault.
    -->
    <ProjectReference Include="..\Aver.Launcher.Platform\Aver.Launcher.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Fonts\Roboto-Regular.ttf" />
    <Resource Include="Fonts\Roboto-Medium.ttf" />
  </ItemGroup>

</Project>
