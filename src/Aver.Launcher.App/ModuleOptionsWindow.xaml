<Window x:Class="Aver.Launcher.App.ModuleOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation options" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource Divider}" BorderThickness="1">
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource H1}" FontSize="19" Text="{Binding Title}" />

            <!-- The honesty line. Modules are compile-time, so this dialog picks an edition rather
                 than composing one, and saying so up front is what stops the checkboxes lying. -->
            <TextBlock Grid.Row="1" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,16"
                       Text="Modules are chosen when the engine is built, so these pick the closest published edition rather than assembling a custom one." />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,8">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}"
                                              IsEnabled="{Binding Unavailable, Converter={StaticResource Not}}"
                                              Foreground="{StaticResource Text}"
                                              FontFamily="{StaticResource UiFontMedium}" FontSize="13"
                                              Content="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{Binding Description}"
                                               TextWrapping="Wrap" Margin="20,4,0,0" FontSize="11" />
                                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="11"
                                               Margin="20,3,0,0" Foreground="{StaticResource TextFaint}"
                                               Text="{Binding Consequence}" />
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="20,3,0,0"
                                               Foreground="{StaticResource Warn}"
                                               Text="No published edition includes this."
                                               Visibility="{Binding Unavailable, Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,13" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="WHAT YOU WILL GET" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding Resolution}" TextWrapping="Wrap"
                               Margin="0,6,0,0" FontSize="12" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="18,9"
                        Click="OnCancel" />
                <Button Content="{Binding ProceedLabel}" Style="{StaticResource AccentButton}"
                        Margin="10,0,0,0" IsEnabled="{Binding CanProceed}" Click="OnProceed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
